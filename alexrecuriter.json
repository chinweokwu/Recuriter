      "data": {
        "name": "POST get-user-info",
        "url": "http://localhost:8000/recruiting/exampleApi/get-user-info",
        "method": "POST",
        "headers": [["Content-Type", "application/json"]],
        "body": "{\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\"\n}",
        "timeoutValue": 10,
        "responsePathways": [
          ["Success", "webhook_response.fallback != true", "", { "id": "confirm-date", "name": "Confirm Date" }],
          ["Fallback", "webhook_response.fallback == true", "", { "id": "date-fallback", "name": "Date Fallback" }]

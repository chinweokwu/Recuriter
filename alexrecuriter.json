    {
      "id": "1",
      "data": {
        "name": "Start & Ask Name",
        "prompt": "Hey there! This is Alex from Bland.ai — how’s your day going? I’m calling about your Support Engineer application. Mind sharing your first and last name with me? You can spell it if that helps!",
        "isStart": true,
        "modelOptions": {
          "modelType": "smart",
          "newTemperature": 0.2,
          "isSMSReturnNode": false,
          "skipUserResponse": false,
          "disableEndCallTool": false,
          "block_interruptions": false,
          "disableSilenceRepeat": false
        }
      },
      "type": "Default",
      "position": { "x": 420, "y": 64 }
    },
    {
      "id": "193b362c-85db-4675-9e47-e0dfbe16789d",
      "data": {
        "name": "Ask Readiness",
        "prompt": "Perfect, {{first_name}}! Is now a good time for a quick chat, or should we pick another time?",
        "modelOptions": { "temperature": 0.3 }
